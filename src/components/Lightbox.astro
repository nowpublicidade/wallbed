---
// Reusable image lightbox/popup.
// Trigger any element with class "lightbox-trigger" and data attributes:
//   data-lightbox-src, data-lightbox-alt, data-lightbox-name, data-lightbox-desc
---

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-hidden="true" aria-label="Visualização do produto">
  <div class="lightbox__backdrop" data-lightbox-close></div>

  <div class="lightbox__content">
    <button class="lightbox__close" type="button" data-lightbox-close aria-label="Fechar">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="lightbox__image-wrap">
      <img class="lightbox__image" id="lightbox-image" src="" alt="" />
    </div>

    <div class="lightbox__info">
      <h3 class="lightbox__name" id="lightbox-name"></h3>
      <p class="lightbox__desc" id="lightbox-desc"></p>
    </div>
  </div>
</div>

<script>
  function initLightbox() {
    const lightbox = document.getElementById('lightbox');
    const img = document.getElementById('lightbox-image') as HTMLImageElement | null;
    const nameEl = document.getElementById('lightbox-name');
    const descEl = document.getElementById('lightbox-desc');
    if (!lightbox || !img || !nameEl || !descEl) return;

    function openLightbox(src: string, alt: string, name: string, desc: string) {
      img!.src = src;
      img!.alt = alt;
      nameEl!.textContent = name;
      descEl!.textContent = desc;
      (descEl as HTMLElement).style.display = desc ? '' : 'none';
      (nameEl as HTMLElement).style.display = name ? '' : 'none';
      lightbox!.classList.add('is-open');
      lightbox!.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      const lenis = (window as any).__lenis;
      if (lenis) lenis.stop();
    }

    function closeLightbox() {
      lightbox!.classList.remove('is-open');
      lightbox!.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      const lenis = (window as any).__lenis;
      if (lenis) lenis.start();
    }

    document.querySelectorAll<HTMLElement>('.lightbox-trigger').forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openLightbox(
          trigger.dataset.lightboxSrc || '',
          trigger.dataset.lightboxAlt || '',
          trigger.dataset.lightboxName || '',
          trigger.dataset.lightboxDesc || ''
        );
      });
    });

    lightbox.querySelectorAll('[data-lightbox-close]').forEach((el) => {
      el.addEventListener('click', closeLightbox);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox.classList.contains('is-open')) closeLightbox();
    });
  }

  document.addEventListener('DOMContentLoaded', initLightbox);
</script>

<style is:global>
  /* ---- Trigger reset (used across product components) ---- */
  .lightbox-trigger {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    border: none;
    background: none;
    font: inherit;
    color: inherit;
    text-align: inherit;
    cursor: zoom-in;
  }
</style>

<style>
  /* ---- Overlay ---- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xl);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8, 8, 10, 0.85);
    backdrop-filter: blur(6px);
    cursor: zoom-out;
  }

  /* ---- Content ---- */
  .lightbox__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    max-width: 900px;
    width: 100%;
    max-height: 90vh;
    background: var(--color-dark-700);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transform: scale(0.94);
    transition: transform 0.3s ease;
  }

  .lightbox.is-open .lightbox__content {
    transform: scale(1);
  }

  .lightbox__close {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    z-index: 2;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    color: var(--color-white);
    cursor: pointer;
    transition: background var(--transition-fast), transform var(--transition-fast);
  }

  .lightbox__close:hover {
    background: var(--color-brand-start);
    transform: rotate(90deg);
  }

  .lightbox__image-wrap {
    flex: 1;
    min-height: 0;
    background: var(--color-dark-800);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox__image {
    width: 100%;
    height: 100%;
    max-height: 65vh;
    object-fit: contain;
    display: block;
  }

  .lightbox__info {
    padding: var(--space-xl) var(--space-2xl);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .lightbox__name {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--space-xs);
  }

  .lightbox__desc {
    font-size: var(--font-size-base);
    color: var(--color-gray-300);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .lightbox {
      padding: var(--space-md);
    }

    .lightbox__info {
      padding: var(--space-lg);
    }

    .lightbox__name {
      font-size: var(--font-size-xl);
    }
  }
</style>
