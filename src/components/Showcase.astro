---
import { Image } from 'astro:assets';
import show01 from '../assets/images/showcase/IMG-SHOW-01.png';
import show02 from '../assets/images/showcase/IMG-SHOW-02.png';
import show03 from '../assets/images/showcase/IMG-SHOW-03.png';
import show04 from '../assets/images/showcase/IMG-SHOW-04.png';
import show05 from '../assets/images/showcase/IMG-SHOW-05.png';

const showcaseImages = [show01, show02, show03, show04, show05];

const steps = [
  { label: 'De dia, um escritório elegante', stat: null, number: '01' },
  { label: 'O painel começa a se transformar', stat: null, number: '02' },
  { label: 'O mecanismo silencioso entra em ação', stat: 'Abertura em 5 segundos', number: '03' },
  { label: 'Seu colchão já está quase pronto', stat: 'Sem nenhum esforço', number: '04' },
  { label: 'De noite, seu quarto de hotel', stat: 'Conforto garantido', number: '05' },
];

const imageAlts = [
  'Cama retrátil WallBed totalmente fechada, parecendo um painel na parede',
  'Cama retrátil começando a abrir, painel inclinado',
  'Cama retrátil a 50 por cento aberta, mecanismo visível',
  'Cama retrátil quase totalmente aberta, colchão aparecendo',
  'Cama retrátil completamente aberta e pronta para uso',
];

const stats = [
  { value: 15, suffix: '+', label: 'Modelos disponíveis', prefix: '' },
  { value: 5000, suffix: '+', label: 'Camas vendidas', prefix: '' },
  { value: 5, suffix: ' anos', label: 'Garantia', prefix: '' },
];
---

<section class="showcase" id="showcase">
  <div class="showcase__viewer">
    <!-- Background image layer -->
    <div class="showcase__image-layer">
      {showcaseImages.map((img, i) => (
        <div class={`showcase__image-wrapper ${i === 0 ? 'is-active' : ''}`} data-step={i}>
          <Image
            src={img}
            alt={imageAlts[i]}
            class="showcase__image"
            width={1920}
            quality={85}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        </div>
      ))}
    </div>

    <!-- Dark overlay for text readability -->
    <div class="showcase__overlay"></div>

    <!-- Text layer -->
    <div class="showcase__text-layer">
      {steps.map((step, i) => (
        <div class={`showcase__step ${i === 0 ? 'is-active' : ''}`} data-step={i}>
          <span class="showcase__step-number">{step.number}</span>
          <h3 class="showcase__step-label">{step.label}</h3>
          {step.stat && <p class="showcase__step-stat">{step.stat}</p>}
        </div>
      ))}
    </div>

    <!-- Progress dots -->
    <div class="showcase__progress">
      <div class="showcase__progress-track">
        <div class="showcase__progress-fill"></div>
      </div>
      <div class="showcase__progress-dots">
        {steps.map((_, i) => (
          <button
            class={`showcase__dot ${i === 0 ? 'is-active' : ''}`}
            data-step={i}
            type="button"
            aria-label={`Passo ${i + 1}`}
          ></button>
        ))}
      </div>
    </div>
  </div>

  <!-- Stats strip -->
  <div class="showcase__stats container">
    <div class="stagger-children showcase__stats-grid">
      {stats.map((stat) => (
        <div class="showcase__stat stagger-item">
          <span
            class="showcase__stat-value counter"
            data-target={stat.value}
            data-suffix={stat.suffix}
            data-prefix={stat.prefix}
          >
            0
          </span>
          <span class="showcase__stat-label">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initShowcase() {
    const viewer = document.querySelector('.showcase__viewer') as HTMLElement;
    if (!viewer) return;

    const imageWrappers = document.querySelectorAll('.showcase__image-wrapper');
    const steps = document.querySelectorAll('.showcase__step');
    const dots = document.querySelectorAll('.showcase__dot');
    const progressFill = document.querySelector('.showcase__progress-fill') as HTMLElement;
    const total = imageWrappers.length;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function goTo(index: number) {
      imageWrappers[current].classList.remove('is-active');
      steps[current].classList.remove('is-active');
      if (dots[current]) dots[current].classList.remove('is-active');

      // Modulo robusto: funciona para índices negativos e maiores que total
      current = ((index % total) + total) % total;

      imageWrappers[current].classList.add('is-active');
      steps[current].classList.add('is-active');
      if (dots[current]) dots[current].classList.add('is-active');

      if (progressFill) {
        if (current === 0) {
          // Ao retornar ao início, reseta a barra sem transição para evitar salto visual
          progressFill.style.transition = 'none';
          progressFill.style.width = '20%';
          // Reativa a transição no próximo frame
          requestAnimationFrame(() => requestAnimationFrame(() => {
            progressFill.style.transition = '';
          }));
        } else {
          progressFill.style.width = `${((current + 1) / total) * 100}%`;
        }
      }
    }

    function startTimer() {
      // Sempre limpa o timer anterior para evitar múltiplos intervalos acumulados
      if (timer) clearInterval(timer);
      timer = setInterval(() => goTo(current + 1), 3000);
    }

    function resetTimer() {
      startTimer(); // startTimer já faz o clearInterval internamente
    }

    // Dot click
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { goTo(i); resetTimer(); });
    });

    // Pause on hover
    viewer.addEventListener('mouseenter', () => { if (timer) clearInterval(timer); });
    viewer.addEventListener('mouseleave', () => startTimer());

    // Scroll-triggered scale-in (no pin, no scrub)
    gsap.fromTo('.showcase__image-layer',
      { scale: 0.92, borderRadius: '20px' },
      {
        scale: 1,
        borderRadius: '0px',
        duration: 0.8,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: '.showcase__viewer',
          start: 'top 85%',
          once: true,
        },
      }
    );

    // Start slider
    goTo(0);
    startTimer();
  }

  document.addEventListener('DOMContentLoaded', initShowcase);
</script>

<style>
  /* ---- Section ---- */
  .showcase {
    background: var(--color-dark-900);
  }

  /* ---- Viewer ---- */
  .showcase__viewer {
    position: relative;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ---- Image layer ---- */
  .showcase__image-layer {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    will-change: transform;
  }

  .showcase__image-wrapper {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 1s ease, transform 1s ease;
    will-change: opacity, transform;
  }

  .showcase__image-wrapper.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .showcase__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* ---- Overlay ---- */
  .showcase__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      180deg,
      rgba(10, 10, 12, 0.55) 0%,
      rgba(10, 10, 12, 0.1) 40%,
      rgba(10, 10, 12, 0.1) 60%,
      rgba(10, 10, 12, 0.75) 100%
    );
    pointer-events: none;
  }

  /* ---- Text layer ---- */
  .showcase__text-layer {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 900px;
    padding-inline: var(--container-padding);
    text-align: center;
    pointer-events: none;
  }

  .showcase__step {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, calc(-50% + 24px));
    width: 100%;
    padding-inline: var(--container-padding);
    opacity: 0;
    transition: opacity 0.6s ease 0.15s, transform 0.6s ease 0.15s;
    will-change: opacity, transform;
  }

  .showcase__step.is-active {
    opacity: 1;
    transform: translate(-50%, -50%);
  }

  .showcase__step-number {
    display: inline-block;
    font-size: var(--font-size-sm);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-start);
    margin-bottom: var(--space-md);
    opacity: 0.9;
  }

  .showcase__step-label {
    font-size: clamp(2rem, 5.5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-white);
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.5);
  }

  .showcase__step-stat {
    margin-top: var(--space-lg);
    font-size: var(--font-size-lg);
    font-weight: 500;
    color: var(--color-brand-start);
    text-shadow: 0 1px 20px rgba(0, 0, 0, 0.4);
  }

  /* ---- Progress ---- */
  .showcase__progress {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .showcase__progress-track {
    width: 200px;
    height: 2px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 1px;
    overflow: hidden;
  }

  .showcase__progress-fill {
    height: 100%;
    width: 20%;
    background: var(--gradient-brand-horizontal);
    border-radius: 1px;
    transition: width 0.4s ease;
  }

  .showcase__progress-dots {
    display: flex;
    gap: var(--space-md);
  }

  .showcase__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    border: none;
    cursor: pointer;
    transition: background 0.3s ease, transform 0.3s ease;
    padding: 0;
  }

  .showcase__dot.is-active {
    background: var(--color-brand-start);
    transform: scale(1.4);
    box-shadow: 0 0 10px rgba(232, 70, 112, 0.6);
  }

  /* ---- Stats ---- */
  .showcase__stats {
    padding-block: var(--space-section);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .showcase__stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2xl);
    text-align: center;
  }

  .showcase__stat-value {
    display: block;
    font-size: var(--font-size-5xl);
    font-weight: 800;
    background: var(--gradient-brand-horizontal);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    margin-bottom: var(--space-sm);
  }

  .showcase__stat-label {
    font-size: var(--font-size-sm);
    color: var(--color-gray-300);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
  }

  /* ---- Mobile ---- */
  @media (max-width: 768px) {
    .showcase__step-label {
      font-size: clamp(1.5rem, 7vw, 2.5rem);
    }

    .showcase__step-stat {
      font-size: var(--font-size-base);
    }

    .showcase__progress-track {
      width: 140px;
    }

    .showcase__stats-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .showcase__stat-value {
      font-size: var(--font-size-4xl);
    }
  }
</style>
