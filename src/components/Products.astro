---
import { Image } from 'astro:assets';
import prod01 from '../assets/images/products/IMG-PROD-01.png';
import prod02 from '../assets/images/products/IMG-PROD-02.png';
import prod03 from '../assets/images/products/IMG-PROD-03.png';
import prod04 from '../assets/images/products/IMG-PROD-04.png';
import prod05 from '../assets/images/products/IMG-PROD-05.png';
import prod06 from '../assets/images/products/IMG-PROD-06.png';

const featured = {
  name: 'Prime Casal',
  line: 'Prime',
  description: 'O topo da linha WallBed. Acabamento em madeira nobre, mecanismo silencioso de alta precisão e design que eleva qualquer ambiente.',
  sizes: 'Casal — 1,38m',
  image: prod01,
  alt: 'Cama retrátil WallBed Prime tamanho casal com acabamento em madeira nobre',
};

const products = [
  {
    name: 'Prime Solteiro',
    line: 'Prime',
    description: 'A mesma sofisticação em tamanho compacto',
    sizes: 'Solteiro — 0,88m',
    image: prod02,
    alt: 'Cama retrátil WallBed Prime tamanho solteiro',
  },
  {
    name: 'Basic Casal',
    line: 'Basic',
    description: 'Design clean e moderno, custo-benefício ideal',
    sizes: 'Casal — 1,38m',
    image: prod03,
    alt: 'Cama retrátil WallBed Basic tamanho casal com acabamento branco',
  },
  {
    name: 'Basic Solteiro',
    line: 'Basic',
    description: 'Minimalismo funcional para espaços inteligentes',
    sizes: 'Solteiro — 0,88m',
    image: prod04,
    alt: 'Cama retrátil WallBed Basic tamanho solteiro',
  },
  {
    name: 'Economic Plus Casal',
    line: 'Economic Plus',
    description: 'Toda a praticidade com o melhor preço',
    sizes: 'Casal — 1,38m',
    image: prod05,
    alt: 'Cama retrátil WallBed Economic Plus tamanho casal',
  },
  {
    name: 'Economic Plus Solteiro',
    line: 'Economic Plus',
    description: 'Solução acessível para qualquer espaço',
    sizes: 'Solteiro — 0,88m',
    image: prod06,
    alt: 'Cama retrátil WallBed Economic Plus tamanho solteiro',
  },
];
---

<section class="products section" id="produtos">
  <div class="container container--wide">

    <!-- Header -->
    <div class="products__header reveal">
      <h2 class="section__title">
        Nossos <span class="products__title-accent">Produtos</span>
      </h2>
      <p class="section__subtitle">
        Linha completa de camas retráteis para cada espaço, estilo e orçamento.
        Do projeto ao dormitório — uma solução elegante.
      </p>
    </div>

    <!-- Featured product -->
    <div class="products__featured reveal">
      <button
        type="button"
        class="products__featured-image lightbox-trigger"
        data-lightbox-src={featured.image.src}
        data-lightbox-alt={featured.alt}
        data-lightbox-name={featured.name}
        data-lightbox-desc={featured.description}
        aria-label={`Ampliar imagem de ${featured.name}`}
      >
        <Image
          src={featured.image}
          alt={featured.alt}
          width={900}
          quality={85}
          class="products__featured-img"
        />
      </button>
      <a href="#contato" class="products__featured-info">
        <span class="products__badge products__badge--featured">{featured.line}</span>
        <h3 class="products__featured-name">{featured.name}</h3>
        <p class="products__featured-desc">{featured.description}</p>
        <span class="products__featured-size">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <rect x="1" y="1" width="14" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          {featured.sizes}
        </span>
        <span class="products__featured-cta">
          Solicitar orçamento
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    </div>

    <!-- Product grid (5 remaining) -->
    <div class="products__grid">
      {products.map((product, i) => (
        <div class={`products__card reveal products__card--${i + 1}`}>
          <button
            type="button"
            class="products__card-image lightbox-trigger"
            data-lightbox-src={product.image.src}
            data-lightbox-alt={product.alt}
            data-lightbox-name={product.name}
            data-lightbox-desc={product.description}
            aria-label={`Ampliar imagem de ${product.name}`}
          >
            <Image
              src={product.image}
              alt={product.alt}
              width={600}
              quality={80}
              class="products__card-img"
            />
          </button>
          <a href="#contato" class="products__card-info">
            <span class="products__badge">{product.line}</span>
            <h3 class="products__card-name">{product.name}</h3>
            <p class="products__card-desc">{product.description}</p>
            <div class="products__card-footer">
              <span class="products__card-size">{product.sizes}</span>
              <span class="products__card-arrow">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* ---- Section ---- */
  .products {
    background: var(--color-dark-900);
  }

  /* ---- Header ---- */
  .products__header {
    margin-bottom: var(--space-3xl);
  }

  .products__title-accent {
    background: var(--gradient-brand-horizontal);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ---- Badge ---- */
  .products__badge {
    display: inline-block;
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 0.3rem 0.875rem;
    border-radius: var(--radius-full);
    background: rgba(232, 70, 112, 0.1);
    color: var(--color-brand-start);
    border: 1px solid rgba(232, 70, 112, 0.2);
    width: fit-content;
  }

  .products__badge--featured {
    padding: 0.4rem 1.25rem;
    font-size: 0.8125rem;
  }

  /* ================================================================
     FEATURED CARD
  ================================================================ */
  .products__featured {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-dark-700);
    border: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: var(--space-2xl);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
    cursor: pointer;
  }

  .products__featured:hover {
    border-color: rgba(232, 70, 112, 0.3);
    box-shadow: 0 0 60px rgba(232, 70, 112, 0.08);
  }

  .products__featured:hover .products__featured-img {
    transform: scale(1.04);
  }

  .products__featured-image {
    overflow: hidden;
    background: var(--color-dark-800);
    aspect-ratio: 4/3;
  }

  .products__featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
    will-change: transform;
  }

  .products__featured-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-lg);
    padding: var(--space-3xl) var(--space-3xl) var(--space-3xl) var(--space-4xl);
    position: relative;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  /* Vertical accent line */
  .products__featured-info::before {
    content: '';
    position: absolute;
    left: 0;
    top: 15%;
    height: 70%;
    width: 2px;
    background: var(--gradient-brand);
    border-radius: 2px;
    opacity: 0.6;
  }

  .products__featured-name {
    font-size: clamp(var(--font-size-3xl), 3vw, var(--font-size-5xl));
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .products__featured-desc {
    font-size: var(--font-size-lg);
    color: var(--color-gray-200);
    line-height: 1.6;
    max-width: 360px;
  }

  .products__featured-size {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--font-size-sm);
    color: var(--color-gray-400);
    font-weight: 500;
  }

  .products__featured-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    width: fit-content;
    padding: 0.875rem 1.75rem;
    background: var(--gradient-brand);
    color: var(--color-white);
    font-size: var(--font-size-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-glow);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    margin-top: var(--space-sm);
  }

  .products__featured:hover .products__featured-cta {
    transform: translateY(-2px);
    box-shadow: 0 0 30px rgba(232, 70, 112, 0.45);
  }

  /* ================================================================
     PRODUCT GRID (5 cards, 3+2 centered layout)
  ================================================================ */
  .products__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-lg);
  }

  .products__card {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    background: var(--color-dark-700);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-xl);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition-base), transform var(--transition-base), box-shadow var(--transition-base);
    cursor: pointer;
  }

  /* Center last 2 cards in row 2 */
  .products__card--4 { grid-column: 2 / 4; }
  .products__card--5 { grid-column: 4 / 6; }

  .products__card:hover {
    border-color: rgba(232, 70, 112, 0.22);
    transform: translateY(-5px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
  }

  .products__card:hover .products__card-img {
    transform: scale(1.06);
  }

  .products__card-image {
    overflow: hidden;
    background: var(--color-dark-800);
    aspect-ratio: 4/3;
  }

  .products__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
    will-change: transform;
  }

  .products__card-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-xl);
    flex: 1;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .products__card-name {
    font-size: var(--font-size-xl);
    font-weight: 700;
    line-height: 1.2;
  }

  .products__card-desc {
    font-size: var(--font-size-sm);
    color: var(--color-gray-300);
    line-height: 1.55;
    flex: 1;
  }

  .products__card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-md);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    margin-top: var(--space-sm);
  }

  .products__card-size {
    font-size: var(--font-size-xs);
    color: var(--color-gray-400);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .products__card-arrow {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(232, 70, 112, 0.08);
    border: 1px solid rgba(232, 70, 112, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand-start);
    transition: background var(--transition-fast), transform var(--transition-fast);
    flex-shrink: 0;
  }

  .products__card:hover .products__card-arrow {
    background: rgba(232, 70, 112, 0.18);
    transform: translateX(3px);
  }

  /* ---- Tablet ---- */
  @media (max-width: 1024px) {
    .products__featured {
      grid-template-columns: 1fr;
    }

    .products__featured-image {
      aspect-ratio: 16/9;
    }

    .products__featured-info {
      padding: var(--space-2xl);
    }

    .products__featured-info::before {
      display: none;
    }
  }

  /* ---- Mobile ---- */
  @media (max-width: 768px) {
    .products__header {
      margin-bottom: var(--space-2xl);
    }

    .products__featured {
      margin-bottom: var(--space-lg);
    }

    .products__featured-info {
      padding: var(--space-xl);
      gap: var(--space-md);
    }

    .products__featured-desc {
      font-size: var(--font-size-base);
    }

    .products__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .products__card,
    .products__card--4,
    .products__card--5 {
      grid-column: 1 / -1;
    }

    .products__card-info {
      padding: var(--space-lg);
    }
  }
</style>
